<?xml version="1.0"?>

<robot name = "bicycle" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="inertial_macros.xacro"/>
    <xacro:include filename="ros2_control.xacro" />
    
    <xacro:property name = "base_length" value = "0.5"/>
    <xacro:property name = "base_width" value = "0.1"/>
    <xacro:property name = "base_height" value = "0.05"/>
    <xacro:property name = "wheel_radius" value = "0.05"/>
    <xacro:property name = "wheel_length" value = "0.1"/>
    <xacro:property name = "cylinder_length" value = "0.1"/>
    <xacro:property name = "cylinder_radius" value = "0.01"/>
    

    
    <material name="blue">
        <color rgba="0 0 0.5 1" />
    </material>
    <material name="grey">
        <color rgba="0.5 0.5 0.5 1" />
    </material>
    <material name="green">
        <color rgba="0 0.5 0 1" />
    </material>
    <material name="red">
        <color rgba="0.5 0 0 1" />
    </material>
    <material name = "white">
        <color rgba = "1 1 1 0.5"/>
    </material>

    <link name = "base_footprint"/>
    <link name = "base_link">
        <visual>
            <geometry>
                <box size = "${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <origin xyz = "0 0 0"/>
            <material name = "blue"/>
        </visual>
        <collision>
            <geometry>
                <box size = "${base_length} ${base_width} ${base_height}"/>
            </geometry>
            <origin xyz = "0 0 0"/>
        </collision>
        <xacro:inertial_box mass="0.01" x="0.5" y="0.1" z="0.05">
            <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:inertial_box>
    </link>

    <link name = "base_visual">
        <visual>
            <geometry>
                <box size = "5 3 ${base_height}"/>
            </geometry>
            <origin xyz = "0 0 0"/>
            <material name = "white"/>
        </visual>
    </link>

    <joint name = "vis_base" type = "fixed">
        <origin xyz = "0 0 0"/>
        <parent link = "base_link"/>
        <child link = "base_visual"/>
    </joint>

    <link name = "front_wheel">
        <visual>
            <geometry>
                <cylinder radius = "${wheel_radius}" length = "${wheel_length}"/>
            </geometry>
            <origin xyz = "0 0 0" rpy = "0 0 0"/>
            <material name = "grey"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius = "${wheel_radius}" length = "${wheel_length}"/>
            </geometry>
            <origin xyz = "0 0 0" rpy = "0 0 0"/>
        </collision>
        <xacro:inertial_cylinder mass="0.01" length="${wheel_length}" radius="${wheel_radius}">
            <origin xyz = "0 0 0" rpy ="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <link name = "rear_wheel">
        <visual>
            <geometry>
                <cylinder radius = "${wheel_radius}" length = "${wheel_length}"/>
            </geometry>
            <origin xyz = "0 0 0" rpy = "0 0 0"/>
            <material name = "grey"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius = "${wheel_radius}" length = "${wheel_length}"/>
            </geometry>
            <origin xyz = "0 0 0" rpy = "0 0 0"/>
        </collision>
        <xacro:inertial_cylinder mass="0.01" length="${wheel_length}" radius="${wheel_radius}">
            <origin xyz = "0 0 0" rpy ="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <link name = "front_wheel_cylinder">
        <visual>
            <geometry>
                <cylinder radius = "0.01" length = "${cylinder_length}"/>
            </geometry>
            <origin xyz = "0 0 0" rpy = "0 0 0"/>
            <material name = "grey"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius = "0.01" length = "${cylinder_length}"/>
            </geometry>
            <origin xyz = "0 0 0" rpy = "0 0 0"/>
        </collision>
        <xacro:inertial_cylinder mass="0.005" length="${cylinder_length}" radius="${cylinder_radius}">
            <origin xyz = "0 0 0" rpy ="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <link name = "rear_wheel_cylinder">
        <visual>
            <geometry>
                <cylinder radius = "0.01" length = "${cylinder_length}"/>
            </geometry>
            <origin xyz = "0 0 0" rpy = "0 0 0"/>
            <material name = "grey"/>
        </visual>
        <collision>
            <geometry>
                <cylinder radius = "0.01" length = "${cylinder_length}"/>
            </geometry>
            <origin xyz = "0 0 0" rpy = "0 0 0"/>
        </collision>
        <xacro:inertial_cylinder mass="0.005" length="${cylinder_length}" radius="${cylinder_radius}">
            <origin xyz = "0 0 0" rpy ="0 0 0"/>
        </xacro:inertial_cylinder>
    </link>

    <joint name = "base_joint" type = "fixed">
        <origin xyz = "0 0 0.2"/>
        <parent link = "base_footprint"/>
        <child link = "base_link"/>
    </joint>


    <joint name = "steering_joint" type = "revolute">
        <origin xyz = "${base_length/2 - wheel_radius} 0 -0.01" rpy = "0 0 0"/>
        <parent link = "base_link"/>
        <child link = "front_wheel_cylinder"/>
        <axis xyz = "0 0 1"/>
        <limit lower="-0.4" upper="0.4" effort="100.0" velocity="0.0"/>
    </joint>

    <joint name = "front_wheel_joint" type = "continuous">
        <origin xyz = "0 0 ${-wheel_radius-wheel_length/2}" rpy = "${-pi/2} 0 0"/>
        <parent link = "front_wheel_cylinder"/>
        <child link = "front_wheel"/>
        <axis xyz = "0 0 1"/>
    </joint>

        <joint name = "base_rear_cylinder_joint" type = "fixed">
        <origin xyz = "${-base_length/2 + wheel_radius} 0 -0.01" rpy = "0 0 0"/>
        <parent link = "base_link"/>
        <child link = "rear_wheel_cylinder"/>
    </joint>

    <joint name = "rear_wheel_joint" type = "continuous">
        <origin xyz = "0 0 ${-wheel_radius-wheel_length/2}" rpy = "${-pi/2} 0 0"/>
        <parent link = "rear_wheel_cylinder"/>
        <child link = "rear_wheel"/>
        <axis xyz = "0 0 1"/>
    </joint>

    <gazebo reference="base_link">
        <material>Gazebo/Red</material>
    </gazebo>

    <!-- <gazebo reference="rear_wheel">
        <material>Gazebo/Black</material>
